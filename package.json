{
  "name": "mypdf",
  "productName": "MyPDF",
  "version": "1.0.0",
  "description": "Unir, reordenar, separar PDFs e converter documentos em PDF — gratuito e offline.",
  "license": "MIT",
  "author": "MyPDF",
  "homepage": "https://github.com/seu-usuario/mypdf",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "mypdf.desktop",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "node scripts/copy-pdfjs-assets.mjs && concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "node scripts/copy-pdfjs-assets.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "app.mypdf.desktop",
    "productName": "MyPDF",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "MyPDF <mypdf@localhost>",
      "synopsis": "Unir, reordenar, separar e converter PDFs offline",
      "syncDesktopName": true
    },
    "deb": {
      "recommends": [
        "libreoffice-writer",
        "libreoffice-impress"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
